<?xml version="1.0" encoding="UTF-8"?>
<!--
  IYAD AZIEZ OS research manifest for Samsung Galaxy Tab A SM-T355Y.
  IMPORTANT: this is a historical LineageOS 18.1 (Android 11) baseline,
  NOT a verified LineageOS 20 / Android 13 manifest and NOT yet build-tested.
  The kernel entry is a candidate older MSM8916 tree whose build script
  explicitly knows gt58lte_aus; branch compatibility must still be validated.
  The product makefile inherits common_full_tablet_wifionly.mk.
-->
<manifest>
    <remote name="github" fetch="https://github.com/" />

    <!-- Exact tablet family device tree; published historical 18.1 branch. -->
    <project name="user20482020/device_samsung_gt58lte"
             path="device/samsung/gt58lte"
             remote="github"
             revision="lineage-18.1-gt58lte" />

    <!-- Shared Samsung GTE platform files used by the device tree. -->
    <project name="BobbyDev21/android_device_samsung_gte-common"
             path="device/samsung/gte-common"
             remote="github"
             revision="lineage-18.1" />

    <!-- Shared MSM8916 device files; historical 18.1 branch. -->
    <project name="retiredtab/android_device_samsung_msm8916-common"
             path="device/samsung/msm8916-common"
             remote="github"
             revision="lineage-18.1" />

    <!-- Candidate kernel; its build script explicitly lists gt58lte_aus / SM-T355Y. -->
    <project name="Galaxy-MSM8916/android_kernel_samsung_msm8916"
             path="kernel/samsung/msm8916"
             remote="github"
             revision="lineage-17.1" />

    <!-- Proprietary files for the exact gt58lte family, historical 18.1 branch. -->
    <project name="user20482020/android_vendor_samsung_gt58lte"
             path="vendor/samsung/gt58lte"
             remote="github"
             revision="lineage-18.1" />
</manifest>
